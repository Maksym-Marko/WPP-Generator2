{
	"name": "mxsfwn-npm-handler",
	"version": "1.4.4",
	"description": "NPM Handler",
	"author": "Maksym Marko",
	"license": "GPL-2.0-or-later",
	"scripts": {
    	"tailwind-css:watch": "onchange \"assets/**/*.{css,scss}\" \"src/**/*.{php,js,jsx,ts,tsx}\" -- npm run tailwind-css:dev",
		"tailwind-css:dev": "set mode=development&& postcss ./assets/css/style.css -o ./build/css/style.css",
    	"tailwind-css:build": "set mode=production&& postcss ./assets/css/style.css -o ./build/css/style.css",
		"gutenberg-js:watch": "wp-scripts start --config webpack.gutenberg.config.js",
		"gutenberg-js:build": "wp-scripts build --config webpack.gutenberg.config.js",
		"native-js:watch": "webpack --watch --mode=development --config webpack.custom.config.js",
		"native-js:build": "webpack --mode=production --config webpack.custom.config.js",
		"start": "npm-run-all --parallel tailwind-css:watch gutenberg-js:watch native-js:watch",
		"build": "npm-run-all tailwind-css:build gutenberg-js:build native-js:build"
	},
	"scriptsForGutenbergCompelling": {
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"tailwind-css:watch": "onchange \"assets/**/*.{css,scss}\" \"src/**/*.{php,js,jsx,ts,tsx}\" -- npm run tailwind-css:dev",
		"tailwind-css:dev": "set mode=development&& postcss ./assets/css/style.css -o ./build/css/style.css",
    	"tailwind-css:build": "set mode=production&& postcss ./assets/css/style.css -o ./build/css/style.css",
		"watch:js": "wp-scripts start --config webpack.gutenberg.config.js",
		"build:js": "wp-scripts build --config webpack.gutenberg.config.js",
		"start": "npm-run-all --parallel tailwind-css:watch watch:js",
		"build": "npm-run-all tailwind-css:build build:js"
	},
	"scriptsForJavaScriptCompelling": {
		"tailwind-css:watch": "onchange \"assets/**/*.{css,scss}\" \"src/**/*.{php,js,jsx,ts,tsx}\" -- npm run tailwind-css:dev",
		"tailwind-css:dev": "set mode=development&& postcss ./assets/css/style.css -o ./build/css/style.css",
    	"tailwind-css:build": "set mode=production&& postcss ./assets/css/style.css -o ./build/css/style.css",
		"watch:js": "webpack --watch --mode=development --config webpack.custom.config.js",
		"build:js": "webpack --mode=production --config webpack.custom.config.js",
		"start": "npm-run-all --parallel tailwind-css:watch watch:js",
		"build": "npm-run-all tailwind-css:build build:js"
	},
	"scriptsForEntireCompelling": {
		"tailwind-css:watch": "onchange \"assets/**/*.{css,scss}\" \"src/**/*.{php,js,jsx,ts,tsx}\" -- npm run tailwind-css:dev",
		"tailwind-css:dev": "set mode=development&& postcss ./assets/css/style.css -o ./build/css/style.css",
    	"tailwind-css:build": "set mode=production&& postcss ./assets/css/style.css -o ./build/css/style.css",
		"gutenberg-js:watch": "wp-scripts start --config webpack.gutenberg.config.js",
		"gutenberg-js:build": "wp-scripts build --config webpack.gutenberg.config.js",
		"native-js:watch": "webpack --watch --mode=development --config webpack.custom.config.js",
		"native-js:build": "webpack --mode=production --config webpack.custom.config.js",
		"start": "npm-run-all --parallel tailwind-css:watch gutenberg-js:watch native-js:watch",
		"build": "npm-run-all tailwind-css:build gutenberg-js:build native-js:build"
	},
	"devDependencies": {
		"@babel/core": "^7.24.9",
		"@babel/preset-env": "^7.24.8",
		"@babel/preset-react": "^7.24.7",
		"@wordpress/scripts": "^30.6.0",
		"autoprefixer": "^10.4.22",
		"babel-loader": "^9.1.3",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^7.0.0",
		"mini-css-extract-plugin": "^2.9.0",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.6",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.80.6",
		"sass-loader": "^16.0.3",
		"style-loader": "^4.0.0",
		"tailwindcss": "^3.4.18",
		"terser-webpack-plugin": "^5.3.10",
		"webpack": "^5.93.0",
		"webpack-cli": "^5.1.4",
		"webpack-dev-server": "^5.0.4",
		"webpack-merge": "^6.0.1"
	},
	"dependencies": {
		"@reduxjs/toolkit": "^2.3.0",
		"@wordpress/i18n": "^5.13.0",
		"axios": "^1.6.7",
		"clsx": "^2.1.1",
		"lodash": "^4.17.21",
		"onchange": "^7.1.0",
		"postcss-cli": "^11.0.1",
		"react-redux": "^9.1.2",
		"react-router-dom": "^6.27.0",
		"redux": "^5.0.1",
		"sass": "^1.80.6",
		"uuid": "^11.1.0"
	}
}
