{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mxsfwn/slider",
	"version": "1.0.0",
	"title": "Slider",
	"category": "mxsfwn-wppgnext",
	"icon": "align-wide",
	"description": "Add a multiple slider horizontal section with navigation controls",
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": false
		}
	},
	"attributes": {
		"backgroundColor": {
			"type": "string",
			"default": "bg-neutral-white"
		}
	},
	"textdomain": "wpp-generator-next",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"viewScript": "file:./view.js"
}