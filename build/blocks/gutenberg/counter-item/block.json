{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "mxsfwn/counter-item",
  "version": "1.0.0",
  "title": "Counter Item",
  "parent": [
    "mxsfwn/review-box"
  ],
  "category": "mxsfwn-wppgnext",
  "icon": "chart-line",
  "description": "Add Counter Item",
  "supports": {
    "html": false,
    "align": [
      "left",
      "right",
      "full",
      "center"
    ]
