    "number": {
      "type": "string",
      "default": "25"
    },
    "postfix": {
      "type": "string",
      "default": "%"
    },
    "text": {
      "type": "string",
      "default": "Uplift in reservations"
    },
    "backgroundColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    }
  },
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "textdomain": "wpp-generator-next"
}